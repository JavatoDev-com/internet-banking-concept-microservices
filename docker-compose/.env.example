# Copy this file to .env in the docker-compose directory and fill in your Supabase project values.
# docker-compose reads these automatically when running docker-compose up.

# Supabase project URL  (e.g. https://abcdefghijklmno.supabase.co)
SUPABASE_URL=https://<project-ref>.supabase.co

# Supabase service_role key (Settings → API in the Supabase dashboard)
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>
